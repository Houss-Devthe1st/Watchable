{
  "expo": {
    "name": "Watchable",
    "slug": "MovieApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/movies-app.png",
    "scheme": "movieapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brainbaby.watchable",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/MainIcon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.brainbaby.watchable"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/movie.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/MainIcon.png",
          "color": "#030014"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/MainIcon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3928cae8-ed57-4050-b3e4-1cfe69f19943"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3928cae8-ed57-4050-b3e4-1cfe69f19943"
    }
  }
}
